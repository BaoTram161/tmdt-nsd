<% content_for :title, "Sản phẩm yêu thích | BLACK GINSENG" %>

<section class="bg-[#F7F4EA] border-b border-[#D8D0B8] py-10">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <p class="text-xs tracking-[0.25em] font-semibold text-[#A8873D]">
      BLACK GINSENG
    </p>
    <h1 class="mt-3 text-3xl font-serif font-bold text-[#123D2B]">
      SẢN PHẨM YÊU THÍCH
    </h1>
    <p class="mt-3 text-sm text-gray-600">
      Những sản phẩm bạn đã lưu lại.
    </p>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-12">
  <% if @products.any? %>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      <% @products.each do |product| %>
        <article class="group bg-white border border-[#E2DDCE] hover:border-[#B99A55] hover:shadow-lg transition">
          <%= link_to product_path(product) do %>
            <div class="aspect-square bg-[#F7F4EA] flex items-center justify-center p-4 overflow-hidden">
              <% if product.image_url.present? %>
                <%= image_tag product.image_url,
                      alt: product.name,
                      class: "w-full h-full object-contain group-hover:scale-105 transition duration-300" %>
              <% else %>
                <span class="text-sm text-gray-400">Hình ảnh đang cập nhật</span>
              <% end %>
            </div>

            <div class="p-4">
              <p class="text-[10px] tracking-wider text-[#A8873D] font-semibold">
                <%= product.category.name.upcase %>
              </p>
              <h2 class="mt-2 min-h-12 font-semibold text-[#263B2E] line-clamp-2">
                <%= product.name %>
              </h2>
              <p class="mt-3 text-lg font-bold text-[#1B5B3A]">
                <%= format_vnd(product.price) %>
              </p>
            </div>
          <% end %>

          <div class="px-4 pb-4 space-y-2">
            <%= button_to "THÊM VÀO GIỎ",
                  add_cart_item_path(product),
                  method: :post,
                  class: "w-full bg-[#123D2B] py-2.5 text-xs font-semibold text-white hover:bg-[#1B5B3A] transition" %>

            <%= button_to "XÓA KHỎI YÊU THÍCH",
                  remove_wishlist_item_path(product),
                  method: :delete,
                  class: "w-full border border-[#D8D0B8] py-2.5 text-xs font-semibold text-gray-600 hover:text-red-600 hover:border-red-300 transition" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="border border-[#D8D0B8] bg-white py-16 px-5 text-center">
      <p class="text-lg font-semibold text-[#123D2B]">
        Bạn chưa có sản phẩm yêu thích
      </p>
      <p class="mt-2 text-sm text-gray-500">
        Hãy lưu lại những sản phẩm bạn quan tâm để dễ dàng tìm thấy sau này.
      </p>

      <%= link_to "KHÁM PHÁ SẢN PHẨM",
            products_path,
            class: "inline-block mt-6 bg-[#123D2B] text-white px-7 py-3 text-sm font-semibold hover:bg-[#1B5B3A] transition" %>
    </div>
  <% end %>
</section>
<% content_for :title, "Đăng nhập | BLACK GINSENG" %>

<section class="min-h-[650px] bg-[#F7F4EA] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md bg-white border border-[#D8D0B8] p-7 md:p-10 shadow-sm">

    <!-- Tiêu đề -->
    <div class="text-center mb-8">
      <p class="text-xs tracking-[0.25em] font-semibold text-[#A8873D]">
        BLACK GINSENG
      </p>

      <h1 class="mt-3 text-2xl font-serif font-bold text-[#123D2B]">
        ĐĂNG NHẬP
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Chào mừng bạn quay trở lại
      </p>
    </div>

    <!-- Thông báo lỗi -->
    <% if alert = flash[:alert] %>
      <div id="alert" class="mb-5 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">
        <%= alert %>
      </div>
    <% end %>

    <!-- Thông báo thành công -->
    <% if notice = flash[:notice] %>
      <div id="notice" class="mb-5 p-3 bg-green-50 border border-green-200 rounded text-sm text-green-700">
        <%= notice %>
      </div>
    <% end %>

    <!-- Form đăng nhập -->
    <%= form_with url: session_path, method: :post do |form| %>

      <!-- Email -->
      <div class="mb-5">
        <%= form.label :email_address, "Email",
              class: "block mb-2 text-sm font-medium text-[#123D2B]" %>

        <%= form.email_field :email_address,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "Nhập địa chỉ email",
              value: params[:email_address],
              class: "w-full h-12 px-4 border border-[#D8D0B8] text-sm text-gray-800 focus:outline-none focus:border-[#A8873D] transition" %>
      </div>

      <!-- Mật khẩu -->
      <div class="mb-5">
        <%= form.label :password, "Mật khẩu",
              class: "block mb-2 text-sm font-medium text-[#123D2B]" %>

        <div data-controller="password-visibility" class="relative">

          <%= form.password_field :password,
                required: true,
                autocomplete: "current-password",
                placeholder: "Nhập mật khẩu",
                maxlength: 72,
                data: { password_visibility_target: "input" },
                class: "w-full h-12 pl-4 pr-12 border border-[#D8D0B8] text-sm text-gray-800 focus:outline-none focus:border-[#A8873D] transition" %>

          <!-- Nút hiện / ẩn mật khẩu -->
          <button type="button"
                  data-action="password-visibility#toggle"
                  class="absolute right-0 top-0 h-12 w-12 flex items-center justify-center text-gray-400 hover:text-[#123D2B] transition"
                  aria-label="Hiện hoặc ẩn mật khẩu">

            <!-- Icon con mắt -->
            <svg data-password-visibility-target="eye"
                 xmlns="http://www.w3.org/2000/svg"
                 width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>

            <!-- Icon con mắt bị gạch -->
            <svg data-password-visibility-target="eyeOff"
                 class="hidden"
                 xmlns="http://www.w3.org/2000/svg"
                 width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
              <path d="m3 3 18 18"/>
              <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/>
              <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3 3.8"/>
              <path d="M6.6 6.6C3.7 8.4 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.1-.8"/>
            </svg>

          </button>
        </div>
      </div>

      <!-- Quên mật khẩu -->
      <div class="text-right mb-6">
        <%= link_to "Quên mật khẩu?",
              new_password_path,
              class: "text-xs text-[#A8873D] hover:underline transition" %>
      </div>

      <!-- Nút đăng nhập -->
      <%= form.submit "ĐĂNG NHẬP",
            class: "w-full h-12 bg-[#123D2B] text-white text-sm font-semibold tracking-wide hover:bg-[#1B5B3A] transition cursor-pointer" %>

    <% end %>

    <!-- Liên kết đăng ký -->
    <div class="mt-7 pt-6 border-t border-[#E5DFCF] text-center">
      <p class="text-sm text-gray-500">
        Bạn chưa có tài khoản?
        <%= link_to "Đăng ký ngay",
              new_registration_path,
              class: "font-semibold text-[#A8873D] hover:underline transition" %>
      </p>
    </div>

  </div>
</section>
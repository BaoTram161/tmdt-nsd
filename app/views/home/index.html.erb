<% content_for :title, "BLACK GINSENG | Nhân sâm đen" %>

<!-- BANNER CHÍNH -->
<section class="bg-[#EDF3ED] overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 py-8 md:py-10 grid md:grid-cols-2 gap-8 lg:gap-12 items-center">

    <!-- NỘI DUNG -->
    <div class="w-full max-w-[560px] mx-auto space-y-5 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-[56px] font-serif font-bold leading-[1.15] text-[#123D2B]">
        NHÂN SÂM ĐEN
        <span class="block mt-3 text-[#A8873D] text-3xl md:text-4xl">
          Tinh hoa từ thiên nhiên
        </span>
      </h1>

      <div class="w-16 h-[2px] bg-[#B99A55] mx-auto"></div>

      <p class="max-w-[520px] mx-auto text-center text-[#59665C] leading-8 text-base md:text-[17px]">
        Khám phá bộ sưu tập sản phẩm nhân sâm đen với nhiều quy cách
        đóng gói, giúp bạn dễ dàng tìm hiểu và lựa chọn sản phẩm phù hợp.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="#san-pham"
           class="inline-flex items-center justify-center px-7 py-3.5 bg-[#123D2B] text-white text-sm font-semibold tracking-wide hover:bg-[#1B5B3A] transition">
          KHÁM PHÁ SẢN PHẨM
        </a>

        <a href="#gioi-thieu"
           class="inline-flex items-center justify-center px-7 py-3.5 border border-[#B99A55] text-[#123D2B] text-sm font-semibold hover:bg-white/60 transition">
          VỀ THƯƠNG HIỆU
        </a>
      </div>
    </div>

    <!-- HÌNH ẢNH SẢN PHẨM -->
    <div class="w-full max-w-[560px] mx-auto">
      <div class="bg-[#F8F6EF] border border-[#E5E0D2] rounded-xl p-3 md:p-4 shadow-sm">
        <%= image_tag "https://lechef.vn/uploads/erp/products/product_image/image_url/397/large_B%E1%BA%A3n_sao_c%E1%BB%A7a_Nh%C3%A2n_S%C3%A2m_%C4%90en_25g.jpg",
              alt: "Sản phẩm nhân sâm đen",
              class: "w-full h-[340px] md:h-[400px] lg:h-[430px] object-contain" %>
      </div>
    </div>

  </div>
</section>

<!-- ĐIỂM NHẤN -->
<section class="bg-[#EDE8D9] border-b border-[#D8D0B8]">
  <div class="max-w-7xl mx-auto px-4 py-7 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">

    <div class="sm:border-r sm:border-[#D8D0B8]">
      <p class="text-[#123D2B] font-serif font-bold">SẢN PHẨM NHÂN SÂM ĐEN</p>
      <p class="text-sm text-gray-600 mt-1">Tập trung vào dòng sản phẩm chuyên biệt</p>
    </div>

    <div class="sm:border-r sm:border-[#D8D0B8]">
      <p class="text-[#123D2B] font-serif font-bold">ĐA DẠNG QUY CÁCH</p>
      <p class="text-sm text-gray-600 mt-1">Nhiều lựa chọn về khối lượng và đóng gói</p>
    </div>

    <div>
      <p class="text-[#123D2B] font-serif font-bold">DỄ DÀNG LỰA CHỌN</p>
      <p class="text-sm text-gray-600 mt-1">Phù hợp với nhu cầu sử dụng</p>
    </div>

  </div>
</section>

<!-- DANH MỤC SẢN PHẨM -->
<section id="danh-muc" class="max-w-7xl mx-auto px-4 py-16">
  <div class="text-center mb-10">
    <p class="text-xs tracking-[0.25em] text-[#A8873D] font-semibold">
      KHÁM PHÁ SẢN PHẨM
    </p>

    <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#123D2B] mt-3">
      DANH MỤC SẢN PHẨM
    </h2>

    <p class="text-gray-600 mt-3">
      Tìm hiểu các dòng sản phẩm nhân sâm đen
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6">
    <% @categories.each do |category| %>
      <% next if category.children.empty? %>

      <article class="group w-full max-w-2xl mx-auto bg-[#F7F4EA] border border-[#D8D0B8] hover:border-[#B99A55] hover:shadow-lg transition text-center">
        <div class="p-7 md:p-9">
          <h3 class="mt-3 text-2xl font-serif font-bold text-[#123D2B]">
            <%= category.name %>
          </h3>

          <p class="mt-2 text-sm text-gray-600">
            Lựa chọn dòng sản phẩm theo nhu cầu của bạn.
          </p>

          <div class="flex flex-wrap justify-center gap-2 mt-6">
            <% category.children.each do |child| %>
              <a href="#san-pham"
                 class="px-4 py-2 bg-white border border-[#D8D0B8] text-sm text-[#244331] hover:bg-[#123D2B] hover:text-white transition">
                <%= child.name %>
              </a>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>

<!-- SẢN PHẨM NỔI BẬT -->
<section id="san-pham" class="bg-[#F1EEE4] border-y border-[#E0D9C7] py-16">
  <div class="max-w-7xl mx-auto px-4">

    <div class="flex flex-col items-center text-center gap-3 mb-9">
      <div>
        <p class="text-xs tracking-[0.25em] text-[#A8873D] font-semibold">
          SẢN PHẨM DÀNH CHO BẠN
        </p>

        <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#123D2B] mt-3">
          SẢN PHẨM NỔI BẬT
        </h2>

        <p class="text-gray-600 mt-2">
          Khám phá các sản phẩm nhân sâm đen.
        </p>
      </div>

      <span class="text-sm text-[#56705F]">
        <%= @featured_products.size %> sản phẩm
      </span>
    </div>

    <% wishlist_ids = session[:wishlist] || [] %>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      <% @featured_products.each do |product| %>
        <%
          in_wishlist = wishlist_ids.include?(product.id.to_s)
          wishlist_path = in_wishlist ? remove_wishlist_item_path(product) : add_wishlist_item_path(product)
          wishlist_method = in_wishlist ? :delete : :post
        %>

        <article class="group bg-white border border-[#E5DFCF] hover:border-[#B99A55] hover:shadow-lg transition duration-300">

          <!-- HÌNH ẢNH VÀ NÚT YÊU THÍCH -->
          <div class="relative aspect-square bg-[#F7F4EA] p-4 md:p-6 flex items-center justify-center overflow-hidden">

            <%= link_to product_path(product),
                  class: "absolute inset-0 z-0 p-4 md:p-6 flex items-center justify-center" do %>

              <% if product.image_url.present? %>
                <%= image_tag product.image_url,
                      alt: product.name,
                      loading: "lazy",
                      class: "w-full h-full object-contain group-hover:scale-105 transition duration-300" %>
              <% else %>
                <div class="text-center text-gray-400">
                  <span class="text-4xl">✧</span>
                  <p class="mt-2 text-xs">Hình ảnh đang cập nhật</p>
                </div>
              <% end %>

            <% end %>

            <!-- NÚT YÊU THÍCH -->
            <%= button_to wishlist_path,
                  method: wishlist_method,
                  form: { class: "absolute top-3 right-3 z-20 m-0" },
                  class: "w-10 h-10 flex items-center justify-center rounded-full border border-red-200 bg-white/95 text-red-500 text-2xl shadow-md hover:bg-white hover:scale-110 transition cursor-pointer",
                  title: in_wishlist ? "Bỏ yêu thích" : "Thêm vào yêu thích",
                  aria: { label: in_wishlist ? "Bỏ yêu thích" : "Thêm vào yêu thích" } do %>
              <%= in_wishlist ? "♥" : "♡" %>
            <% end %>

            <!-- NHÃN GIẢM GIÁ -->
            <% if product.on_sale? %>
              <span class="absolute top-3 left-3 z-10 pointer-events-none bg-[#A8873D] text-white text-[10px] font-semibold px-2 py-1">
                -<%= product.discount_percent %>%
              </span>
            <% end %>

          </div>

          <!-- THÔNG TIN SẢN PHẨM VÀ BỘ CHỌN SỐ LƯỢNG -->
          <div class="p-3 md:p-4" data-controller="quantity">

            <p class="text-[10px] md:text-xs tracking-wider text-[#A8873D] font-semibold">
              <%= product.brand.presence || "BLACK GINSENG" %>
            </p>

            <%= link_to product_path(product) do %>
              <h3 class="mt-2 text-sm font-semibold text-[#123D2B] leading-5 line-clamp-2 min-h-10 hover:text-[#A8873D] transition">
                <%= product.name %>
              </h3>
            <% end %>

            <!-- GIÁ -->
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <span class="text-sm md:text-base font-bold text-[#1B5B3A]">
                <%= format_vnd(product.price) %>
              </span>

              <% if product.on_sale? %>
                <span class="text-xs text-gray-400 line-through">
                  <%= format_vnd(product.original_price) %>
                </span>
              <% end %>
            </div>

            <!-- SỐ LƯỢNG VÀ TÌNH TRẠNG -->
            <div class="mt-3 flex items-center justify-between gap-1">

              <% if product.in_stock? %>
                <span class="inline-flex items-center gap-1.5 text-[10px] md:text-xs text-green-700 whitespace-nowrap">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                  Còn hàng
                </span>

                <!-- BỘ CHỌN SỐ LƯỢNG -->
                <div class="flex items-center border border-[#D8D0B8] rounded-sm shrink-0">
                  <button type="button"
                          data-action="quantity#decrease"
                          aria-label="Giảm số lượng"
                          class="w-7 h-7 flex items-center justify-center text-[#123D2B] hover:bg-[#F7F4EA] transition">
                    −
                  </button>

                  <input type="number"
                         value="1"
                         min="1"
                         max="<%= product.stock %>"
                         data-quantity-target="input"
                         data-action="change->quantity#validate"
                         aria-label="Số lượng sản phẩm"
                         class="w-8 h-7 p-0 text-center text-xs font-semibold text-[#123D2B] border-x border-[#D8D0B8] focus:outline-none appearance-none">

                  <button type="button"
                          data-action="quantity#increase"
                          aria-label="Tăng số lượng"
                          class="w-7 h-7 flex items-center justify-center text-[#123D2B] hover:bg-[#F7F4EA] transition">
                    +
                  </button>
                </div>

              <% else %>
                <span class="inline-flex items-center gap-1.5 text-[10px] md:text-xs text-red-600">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                  Hết hàng
                </span>
              <% end %>

            </div>

            <!-- HAI NÚT MUA HÀNG VÀ CHI TIẾT -->
            <div class="mt-4 grid grid-cols-2 gap-2">

              <% if product.in_stock? %>
                <%= form_with url: add_cart_item_path(product),
                              method: :post,
                              local: true,
                              class: "min-w-0" do %>

                  <input type="hidden"
                         name="quantity"
                         value="1"
                         data-quantity-target="formInput">

                  <button type="submit"
                          class="w-full min-h-10 px-2 py-2 flex items-center justify-center gap-1.5 bg-[#123D2B] text-white text-[9px] md:text-[11px] font-semibold tracking-wide hover:bg-[#1B5B3A] transition">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="15"
                         height="15"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                      <circle cx="9" cy="21" r="1"></circle>
                      <circle cx="20" cy="21" r="1"></circle>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>

                    <span>THÊM VÀO GIỎ</span>
                  </button>

                <% end %>
              <% else %>
                <button type="button"
                        disabled
                        class="w-full min-h-10 px-2 py-2 bg-gray-300 text-gray-500 text-[9px] md:text-[11px] font-semibold cursor-not-allowed">
                  HẾT HÀNG
                </button>
              <% end %>

              <%= link_to product_path(product),
                    class: "w-full min-h-10 px-2 py-2 flex items-center justify-center border border-[#123D2B] bg-white text-[#123D2B] text-[9px] md:text-[11px] font-semibold tracking-wide hover:bg-[#123D2B] hover:text-white transition" do %>
                XEM CHI TIẾT
              <% end %>

            </div>

          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<!-- GIỚI THIỆU -->
<section id="gioi-thieu" class="max-w-7xl mx-auto px-4 py-16">
  <div class="relative overflow-hidden bg-[#123D2B] px-7 py-12 md:px-16 md:py-16 text-center text-white">

    <div class="absolute inset-0 opacity-10"
         style="background: radial-gradient(circle at center, #E9CF8A, transparent 65%);">
    </div>

    <div class="relative">
      <p class="text-xs tracking-[0.3em] text-[#E9CF8A] font-semibold">
        VỀ BLACK GINSENG
      </p>

      <h2 class="text-3xl md:text-4xl font-serif font-bold mt-4">
        TINH HOA NHÂN SÂM ĐEN TỪ WISCONSIN – HOA KỲ
      </h2>

      <div class="w-16 h-[2px] bg-[#D4AF62] mx-auto mt-6"></div>

      <p class="max-w-2xl mx-auto text-green-100 leading-8 mt-6">
        BLACK GINSENG mang đến không gian mua sắm chuyên biệt dành cho
        những ai quan tâm và tìm hiểu về nhân sâm đen.
        Với đa dạng sản phẩm và quy cách lựa chọn, chúng tôi hướng đến
        trải nghiệm mua sắm thuận tiện, thông tin sản phẩm rõ ràng
        và dễ dàng khám phá.
      </p>

      <a href="#san-pham"
         class="inline-block mt-8 px-8 py-3 bg-[#D4AF62] text-[#0B291D] font-bold hover:bg-[#E9CF8A] transition">
        KHÁM PHÁ SẢN PHẨM
      </a>
    </div>

  </div>
</section>
<%= form_with model: [:admin, @product], class: "space-y-6" do |form| %>

  <% if @product.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="mb-2 font-semibold">Vui lòng kiểm tra lại thông tin:</p>
      <ul class="list-inside list-disc">
        <% @product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <div class="md:col-span-2">
      <%= form.label :name, "Tên sản phẩm *", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.text_field :name, required: true,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm focus:border-[#1B5B3A] focus:outline-none" %>
    </div>

    <div>
      <%= form.label :brand, "Thương hiệu", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.text_field :brand,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div>
      <%= form.label :category_id, "Danh mục *", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.select :category_id,
          options_for_select(
            @categories.map { |c| [c.parent ? "#{c.parent.name} / #{c.name}" : c.name, c.id] },
            @product.category_id
          ),
          { prompt: "Chọn danh mục" },
          required: true,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div>
      <%= form.label :price, "Giá bán (VNĐ) *", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.number_field :price, min: 1, step: 1000, required: true,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div>
      <%= form.label :original_price, "Giá gốc (VNĐ)", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.number_field :original_price, min: 1, step: 1000,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div>
      <%= form.label :stock, "Số lượng tồn kho *", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.number_field :stock, min: 0, step: 1, required: true,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div>
      <%= form.label :packaging, "Quy cách đóng gói", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.text_field :packaging,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div>
      <%= form.label :origin, "Xuất xứ", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.text_field :origin,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :image_url, "Đường dẫn hình ảnh", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.text_field :image_url, placeholder: "Ví dụ: /products/ten-anh.jpg",
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
      <p class="mt-1 text-xs text-gray-500">
        Nhập đường dẫn ảnh hiện có trong website hoặc URL hình ảnh.
      </p>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "Mô tả sản phẩm", class: "mb-2 block text-sm font-semibold text-[#123D2B]" %>
      <%= form.text_area :description, rows: 5,
          class: "w-full rounded-lg border border-[#D8D0B8] px-4 py-3 text-sm" %>
    </div>
  </div>

  <div class="space-y-3 rounded-lg bg-[#F7F4EA] p-4">
    <label class="flex items-center gap-3 text-sm text-[#123D2B]">
      <%= form.check_box :featured, class: "h-4 w-4 accent-[#1B5B3A]" %>
      Sản phẩm nổi bật
    </label>

    <label class="flex items-center gap-3 text-sm text-[#123D2B]">
      <%= form.check_box :active, class: "h-4 w-4 accent-[#1B5B3A]" %>
      Hiển thị sản phẩm trên website
    </label>
  </div>

  <div class="flex flex-wrap gap-3 border-t border-[#D8D0B8] pt-5">
    <%= form.submit(@product.persisted? ? "LƯU THAY ĐỔI" : "THÊM SẢN PHẨM",
        class: "rounded-lg bg-[#123D2B] px-6 py-3 text-sm font-semibold text-white hover:bg-[#1B5B3A]") %>

    <%= link_to "HỦY", admin_products_path,
        class: "rounded-lg border border-[#D8D0B8] px-6 py-3 text-sm font-semibold text-[#123D2B] hover:bg-[#F7F4EA]" %>
  </div>

<% end %>

<% content_for :title, "Trang quản trị | BLACK GINSENG" %>

<div class="min-h-screen bg-[#F7F4EA] px-4 py-10 md:px-8">
  <div class="mx-auto max-w-7xl">

    <!-- TIÊU ĐỀ -->
    <div class="mb-9 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="mb-2 text-xs font-semibold tracking-[0.25em] text-[#B99A55]">
          BLACK GINSENG
        </p>

        <h1 class="text-3xl font-bold tracking-wide text-[#123D2B]">
          TRANG QUẢN TRỊ
        </h1>

        <p class="mt-2 text-sm text-gray-600">
          Chào mừng bạn đến với hệ thống quản lý cửa hàng.
        </p>
      </div>

    </div>

    <!-- THỐNG KÊ TỔNG QUAN -->
    <section class="mb-10">
      <div class="mb-5">
        <h2 class="text-lg font-semibold text-[#123D2B]">
          TỔNG QUAN CỬA HÀNG
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          Tình hình hoạt động hiện tại của BLACK GINSENG.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">

        <!-- Tổng đơn hàng -->
        <div class="border border-[#D8D0B8] bg-white p-5 shadow-sm">
          <p class="text-sm text-gray-500">Tổng đơn hàng</p>

          <p class="mt-4 text-3xl font-bold text-[#123D2B]">
            <%= @total_orders %>
          </p>

          <p class="mt-1 text-xs text-gray-500">
            Đơn hàng đã được tạo
          </p>
        </div>

        <!-- Đơn chờ xác nhận -->
        <div class="border border-[#D8D0B8] bg-white p-5 shadow-sm">
          <p class="text-sm text-gray-500">Chờ xác nhận</p>

          <p class="mt-4 text-3xl font-bold text-[#A8873D]">
            <%= @pending_orders %>
          </p>

          <p class="mt-1 text-xs text-gray-500">
            Đơn hàng cần xử lý
          </p>
        </div>

        <!-- Sản phẩm -->
        <div class="border border-[#D8D0B8] bg-white p-5 shadow-sm">
          <p class="text-sm text-gray-500">Sản phẩm</p>

          <p class="mt-4 text-3xl font-bold text-[#123D2B]">
            <%= @total_products %>
          </p>

          <p class="mt-1 text-xs text-gray-500">
            Sản phẩm trong cửa hàng
          </p>
        </div>

        <!-- Khách hàng -->
        <div class="border border-[#D8D0B8] bg-white p-5 shadow-sm">
          <p class="text-sm text-gray-500">Khách hàng</p>

          <p class="mt-4 text-3xl font-bold text-[#123D2B]">
            <%= @total_customers %>
          </p>

          <p class="mt-1 text-xs text-gray-500">
            Tài khoản khách hàng
          </p>
        </div>

      </div>
    </section>

    <!-- ĐƠN HÀNG GẦN ĐÂY -->
    <section class="mb-10 border border-[#D8D0B8] bg-white shadow-sm">
      <div class="flex flex-col justify-between gap-3 border-b border-[#D8D0B8] px-5 py-5 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-lg font-semibold text-[#123D2B]">
            ĐƠN HÀNG GẦN ĐÂY
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Theo dõi những đơn hàng mới nhất từ khách hàng.
          </p>
        </div>

        <%= link_to admin_orders_path,
              class: "text-xs font-semibold tracking-wide text-[#8B6D2F] transition hover:text-[#123D2B]" do %>
          XEM TẤT CẢ ĐƠN HÀNG 
        <% end %>
      </div>

      <% if @recent_orders.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[750px] text-left text-sm">
            <thead class="bg-[#F7F4EA] text-xs text-gray-600">
              <tr>
                <th class="px-5 py-4 font-semibold">MÃ ĐƠN HÀNG</th>
                <th class="px-5 py-4 font-semibold">NGƯỜI NHẬN</th>
                <th class="px-5 py-4 font-semibold">NGÀY ĐẶT</th>
                <th class="px-5 py-4 font-semibold">TỔNG TIỀN</th>
                <th class="px-5 py-4 font-semibold">TRẠNG THÁI</th>
                <th class="px-5 py-4 text-center font-semibold">CHI TIẾT</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-[#E8E1D2]">
              <% @recent_orders.each do |order| %>
                <tr class="transition hover:bg-[#FCFBF7]">
                  <td class="px-5 py-4 font-semibold text-[#123D2B]">
                    <%= order.order_number %>
                  </td>

                  <td class="px-5 py-4 text-gray-700">
                    <%= order.recipient_name %>
                  </td>

                  <td class="px-5 py-4 text-gray-600">
                    <%= order.created_at.in_time_zone("Asia/Ho_Chi_Minh").strftime("%d/%m/%Y %H:%M") %>
                  </td>

                  <td class="px-5 py-4 font-semibold text-[#A83232]">
                    <%= format_vnd(order.total) %>
                  </td>

                  <td class="px-5 py-4">
                    <span class="inline-block border border-[#D8D0B8] px-3 py-1.5 text-xs text-[#8B6D2F]">
                      <%= order_status_label(order.status) %>
                    </span>
                  </td>

                  <td class="px-5 py-4 text-center">
                    <%= link_to "XEM",
                          admin_order_path(order),
                          class: "font-semibold text-[#123D2B] hover:text-[#B99A55]" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-5 py-14 text-center">
          <p class="font-semibold text-[#123D2B]">
            CHƯA CÓ ĐƠN HÀNG
          </p>

          <p class="mt-2 text-sm text-gray-500">
            Đơn hàng của khách hàng sẽ xuất hiện tại đây.
          </p>
        </div>
      <% end %>
    </section>

    <!-- QUẢN LÝ CỬA HÀNG -->
    <section class="mb-8">
      <div class="mb-5">
        <h2 class="text-lg font-semibold text-[#123D2B]">
          QUẢN LÝ CỬA HÀNG
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          Truy cập các khu vực quản lý của hệ thống.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">

        <!-- Quản lý sản phẩm -->
        <%= link_to admin_products_path,
              class: "group flex min-h-52 flex-col border border-[#D8D0B8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-[#B99A55] hover:shadow-md" do %>

          <h3 class="text-base font-semibold text-[#123D2B]">
            Quản lý sản phẩm
          </h3>

          <p class="mt-3 flex-1 text-sm leading-6 text-gray-500">
            Quản lý danh sách, thông tin, giá bán và số lượng tồn kho.
          </p>

          <span class="mt-6 text-xs font-semibold tracking-wide text-[#8B6D2F] group-hover:text-[#123D2B]">
            TRUY CẬP NGAY 
          </span>
        <% end %>

        <!-- Quản lý đơn hàng -->
        <%= link_to admin_orders_path,
              class: "group flex min-h-52 flex-col border border-[#D8D0B8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-[#B99A55] hover:shadow-md" do %>

          <h3 class="text-base font-semibold text-[#123D2B]">
            Quản lý đơn hàng
          </h3>

          <p class="mt-3 flex-1 text-sm leading-6 text-gray-500">
            Theo dõi đơn hàng, xem thông tin và cập nhật trạng thái xử lý.
          </p>

          <span class="mt-6 text-xs font-semibold tracking-wide text-[#8B6D2F] group-hover:text-[#123D2B]">
            TRUY CẬP NGAY 
          </span>
        <% end %>

        <!-- Quản lý khách hàng -->
        <%= link_to admin_customers_path,
              class: "group flex min-h-52 flex-col border border-[#D8D0B8] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-[#B99A55] hover:shadow-md" do %>

          <h3 class="text-base font-semibold text-[#123D2B]">
            Quản lý khách hàng
          </h3>

          <p class="mt-3 flex-1 text-sm leading-6 text-gray-500">
            Theo dõi tài khoản và thông tin khách hàng đã đăng ký.
          </p>

          <span class="mt-6 text-xs font-semibold tracking-wide text-[#8B6D2F] group-hover:text-[#123D2B]">
            TRUY CẬP NGAY 
          </span>
        <% end %>

      </div>
    </section>

    <!-- CUỐI TRANG -->
    <div class="border-t border-[#D8D0B8] pt-5 text-center text-xs text-gray-500">
      BLACK GINSENG · HỆ THỐNG QUẢN TRỊ CỬA HÀNG
    </div>

  </div>
</div>
<% content_for :title, "Quản lý khuyến mãi | BLACK GINSENG" %>

<div class="min-h-screen bg-[#F7F4EA] px-4 py-10 md:px-8">
  <div class="mx-auto max-w-7xl">

    <div class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="mb-2 text-xs font-semibold tracking-[0.25em] text-[#B99A55]">
          BLACK GINSENG
        </p>
        <h1 class="text-3xl font-bold tracking-wide text-[#123D2B]">
          QUẢN LÝ KHUYẾN MÃI
        </h1>
        <p class="mt-2 text-sm text-gray-500">
          Tạo và quản lý các chương trình ưu đãi dành cho khách hàng.
        </p>
      </div>

      <%= link_to new_admin_promotion_code_path,
            class: "inline-flex items-center justify-center bg-[#123D2B] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#1B5B3A]" do %>
        + TẠO MÃ KHUYẾN MÃI
      <% end %>
    </div>

    <section class="mb-6 grid gap-4 sm:grid-cols-3">
      <div class="border border-[#D8D0B8] bg-white p-5">
        <p class="text-sm text-gray-500">Tổng mã khuyến mãi</p>
        <p class="mt-3 text-3xl font-bold text-[#123D2B]">
          <%= PromotionCode.count %>
        </p>
      </div>

      <div class="border border-[#D8D0B8] bg-white p-5">
        <p class="text-sm text-gray-500">Đang kích hoạt</p>
        <p class="mt-3 text-3xl font-bold text-[#1B5B3A]">
          <%= PromotionCode.where(active: true).count %>
        </p>
      </div>

      <div class="border border-[#D8D0B8] bg-white p-5">
        <p class="text-sm text-gray-500">Đã tạm ngưng</p>
        <p class="mt-3 text-3xl font-bold text-gray-500">
          <%= PromotionCode.where(active: false).count %>
        </p>
      </div>
    </section>

    <section class="mb-6 border border-[#D8D0B8] bg-white p-5">
      <%= form_with url: admin_promotion_codes_path,
                    method: :get,
                    class: "flex flex-col gap-3 md:flex-row" do |form| %>
        <%= form.search_field :q,
              value: params[:q],
              placeholder: "Tìm theo mã khuyến mãi...",
              class: "min-w-0 flex-1 border border-[#D8D0B8] px-4 py-3 text-sm outline-none focus:border-[#B99A55]" %>

        <%= form.select :status,
              options_for_select(
                [["Tất cả trạng thái", ""],
                 ["Đang kích hoạt", "active"],
                 ["Đã tạm ngưng", "inactive"]],
                params[:status]
              ),
              {},
              class: "border border-[#D8D0B8] bg-white px-4 py-3 text-sm outline-none focus:border-[#B99A55]" %>

        <%= form.submit "TÌM KIẾM",
              class: "cursor-pointer bg-[#123D2B] px-6 py-3 text-xs font-semibold tracking-wide text-white transition hover:bg-[#1B5B3A]" %>

        <%= link_to "ĐẶT LẠI",
              admin_promotion_codes_path,
              class: "border border-[#D8D0B8] px-6 py-3 text-center text-xs font-semibold text-[#123D2B] transition hover:bg-[#F7F4EA]" %>
      <% end %>
    </section>

    <section class="overflow-hidden border border-[#D8D0B8] bg-white shadow-sm">
      <div class="border-b border-[#D8D0B8] px-5 py-5">
        <h2 class="font-semibold text-[#123D2B]">
          DANH SÁCH MÃ KHUYẾN MÃI
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          Có <%= @promotion_codes.count %> mã trong kết quả tìm kiếm.
        </p>
      </div>

      <% if @promotion_codes.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[950px] text-left text-sm">
            <thead class="bg-[#F7F4EA] text-xs text-gray-600">
              <tr>
                <th class="px-5 py-4 font-semibold">MÃ KHUYẾN MÃI</th>
                <th class="px-5 py-4 font-semibold">MỨC GIẢM</th>
                <th class="px-5 py-4 font-semibold">ĐÃ SỬ DỤNG</th>
                <th class="px-5 py-4 font-semibold">THỜI HẠN</th>
                <th class="px-5 py-4 font-semibold">TRẠNG THÁI</th>
                <th class="px-5 py-4 text-center font-semibold">THAO TÁC</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-[#E8E1D2]">
              <% @promotion_codes.each do |promotion_code| %>
                <tr class="transition hover:bg-[#FCFBF7]">
                  <td class="px-5 py-4">
                    <p class="font-bold tracking-wide text-[#123D2B]">
                      <%= promotion_code.code %>
                    </p>
                    <p class="mt-1 text-xs text-gray-500">
                      <%= promotion_code.description.presence || "Không có mô tả" %>
                    </p>
                  </td>

                  <td class="px-5 py-4 font-semibold text-[#A83232]">
                    <% if promotion_code.percentage? %>
                      <%= number_to_percentage(promotion_code.discount_value, precision: 0, strip_insignificant_zeros: true) %>
                    <% else %>
                      <%= format_vnd(promotion_code.discount_value) %>
                    <% end %>
                  </td>

                  <td class="px-5 py-4 text-gray-700">
                    <%= promotion_code.used_count %>
                    /
                    <%= promotion_code.usage_limit || "∞" %>
                  </td>

                  <td class="px-5 py-4 text-gray-600">
                    <p>
                      <%= promotion_code.starts_at&.strftime("%d/%m/%Y %H:%M") || "Không giới hạn" %>
                    </p>
                    <p class="mt-1 text-xs text-gray-500">
                      đến <%= promotion_code.expires_at&.strftime("%d/%m/%Y %H:%M") || "Không giới hạn" %>
                    </p>
                  </td>

                  <td class="px-5 py-4">
                    <% if promotion_code.available? %>
                      <span class="border border-[#B8D5BE] bg-[#EFF7F0] px-3 py-1.5 text-xs font-medium text-[#27643A]">
                        Đang hoạt động
                      </span>
                    <% elsif promotion_code.active? %>
                      <span class="border border-[#E8D7AE] bg-[#FBF5E8] px-3 py-1.5 text-xs font-medium text-[#8B6D2F]">
                        Chưa khả dụng
                      </span>
                    <% else %>
                      <span class="border border-gray-200 bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-500">
                        Đã tạm ngưng
                      </span>
                    <% end %>
                  </td>

                  <td class="px-5 py-4">
                    <div class="flex items-center justify-center gap-4">
                      <%= link_to "SỬA",
                            edit_admin_promotion_code_path(promotion_code),
                            class: "font-semibold text-[#123D2B] hover:text-[#B99A55]" %>

                      <%= button_to(
                            promotion_code.active? ? "TẠM NGƯNG" : "KÍCH HOẠT",
                            toggle_active_admin_promotion_code_path(promotion_code),
                            method: :patch,
                            class: "cursor-pointer font-semibold text-[#8B6D2F] hover:text-[#123D2B]"
                          ) %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-5 py-16 text-center">
          <h3 class="font-semibold text-[#123D2B]">
            CHƯA CÓ MÃ KHUYẾN MÃI
          </h3>
          <p class="mt-2 text-sm text-gray-500">
            Hãy tạo mã khuyến mãi đầu tiên cho cửa hàng.
          </p>
          <%= link_to "TẠO MÃ NGAY",
                new_admin_promotion_code_path,
                class: "mt-5 inline-block bg-[#123D2B] px-6 py-3 text-xs font-semibold text-white hover:bg-[#1B5B3A]" %>
        </div>
      <% end %>
    </section>


  </div>
</div>

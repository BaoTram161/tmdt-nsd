<% content_for :title, "Chi tiết đơn hàng | BLACK GINSENG" %>

<div class="min-h-screen bg-[#F7F4EA] px-4 py-10 md:px-8">
  <div class="mx-auto max-w-5xl">

    <div class="mb-8">
      <p class="mb-2 text-xs font-semibold tracking-[0.2em] text-[#B99A55]">
        BLACK GINSENG
      </p>

      <h1 class="text-2xl font-semibold text-[#123D2B] md:text-3xl">
        CHI TIẾT ĐƠN HÀNG
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Mã đơn: <%= @order.order_number %>
      </p>
    </div>

    <!-- Thông tin đơn hàng -->
    <div class="mb-6 border border-[#D8D0B8] bg-white p-5 md:p-7">
      <h2 class="mb-5 text-sm font-semibold text-[#123D2B]">
        THÔNG TIN ĐƠN HÀNG
      </h2>

      <div class="grid gap-5 text-sm sm:grid-cols-2">
        <div>
          <p class="text-xs text-gray-500">MÃ ĐƠN HÀNG</p>
          <p class="mt-1 font-semibold text-[#123D2B]">
            <%= @order.order_number %>
          </p>
        </div>

        <div>
          <p class="text-xs text-gray-500">NGÀY ĐẶT</p>
          <p class="mt-1 text-gray-800">
            <%= @order.created_at.in_time_zone("Asia/Ho_Chi_Minh").strftime("%d/%m/%Y %H:%M") %>
          </p>
        </div>

        <div>
          <p class="text-xs text-gray-500">TÀI KHOẢN KHÁCH HÀNG</p>
          <p class="mt-1 text-gray-800">
            <%= @order.user.email_address %>
          </p>
        </div>

        <div>
          <p class="text-xs text-gray-500">PHƯƠNG THỨC THANH TOÁN</p>
          <p class="mt-1 text-gray-800">
            Thanh toán khi nhận hàng (COD)
          </p>
          <p class="mt-1 text-xs text-[#8B6D2F]">
            <%= @order.unpaid? ? "Chưa thanh toán" : (@order.paid? ? "Đã thanh toán" : "Đã hoàn tiền") %>
          </p>
        </div>
      </div>
    </div>

    <!-- Thông tin người nhận -->
    <div class="mb-6 border border-[#D8D0B8] bg-white p-5 md:p-7">
      <h2 class="mb-5 text-sm font-semibold text-[#123D2B]">
        THÔNG TIN NHẬN HÀNG
      </h2>

      <div class="grid gap-5 text-sm sm:grid-cols-2">
        <div>
          <p class="text-xs text-gray-500">NGƯỜI NHẬN</p>
          <p class="mt-1 font-medium text-gray-800">
            <%= @order.recipient_name %>
          </p>
        </div>

        <div>
          <p class="text-xs text-gray-500">SỐ ĐIỆN THOẠI</p>
          <p class="mt-1 font-medium text-gray-800">
            <%= @order.phone %>
          </p>
        </div>

        <div class="sm:col-span-2">
          <p class="text-xs text-gray-500">ĐỊA CHỈ GIAO HÀNG</p>
          <p class="mt-1 leading-6 text-gray-800">
            <%= [@order.street_address, @order.ward, @order.province].compact_blank.join(", ") %>
          </p>
        </div>

        <% if @order.note.present? %>
          <div class="sm:col-span-2">
            <p class="text-xs text-gray-500">GHI CHÚ</p>
            <p class="mt-1 text-gray-800"><%= @order.note %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sản phẩm -->
    <div class="mb-6 border border-[#D8D0B8] bg-white p-5 md:p-7">
      <h2 class="mb-5 text-sm font-semibold text-[#123D2B]">
        SẢN PHẨM ĐÃ ĐẶT
      </h2>

      <div class="space-y-5">
        <% @order.order_items.each do |item| %>
          <div class="flex items-center gap-4">
            <% if item.product_image.present? %>
              <%= image_tag item.product_image,
                    class: "h-20 w-20 shrink-0 border border-[#D8D0B8] object-cover",
                    alt: item.product_name %>
            <% else %>
              <div class="flex h-20 w-20 shrink-0 items-center justify-center border border-[#D8D0B8] bg-[#F7F4EA] text-[10px] text-gray-400">
                BLACK GINSENG
              </div>
            <% end %>

            <div class="min-w-0 flex-1">
              <p class="font-medium text-[#123D2B]">
                <%= item.product_name %>
              </p>
              <p class="mt-1 text-sm text-gray-500">
                Đơn giá: <%= format_vnd(item.unit_price) %>
              </p>
              <p class="mt-1 text-sm text-gray-500">
                Số lượng: <%= item.quantity %>
              </p>
            </div>

            <p class="shrink-0 text-sm font-semibold text-[#A83232]">
              <%= format_vnd(item.total_price) %>
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tổng tiền -->
    <div class="mb-6 border border-[#D8D0B8] bg-white p-5 md:p-7">
      <h2 class="mb-5 text-sm font-semibold text-[#123D2B]">
        TỔNG THANH TOÁN
      </h2>

      <div class="ml-auto max-w-sm space-y-3 text-sm">
        <div class="flex justify-between text-gray-600">
          <span>Tiền hàng</span>
          <span><%= format_vnd(@order.subtotal) %></span>
        </div>

        <div class="flex justify-between text-gray-600">
          <span>Phí vận chuyển</span>
          <span><%= format_vnd(@order.shipping_fee) %></span>
        </div>

        <div class="flex justify-between border-t border-[#D8D0B8] pt-4 font-semibold text-[#123D2B]">
          <span>Tổng thanh toán</span>
          <span class="text-[#A83232]">
            <%= format_vnd(@order.total) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Cập nhật trạng thái -->
    <div class="mb-8 border border-[#D8D0B8] bg-white p-5 md:p-7">
      <h2 class="mb-5 text-sm font-semibold text-[#123D2B]">
        CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG
      </h2>

      <div class="mb-4 text-sm text-gray-600">
        Trạng thái hiện tại:
        <span class="font-semibold text-[#8B6D2F]">
          <%= order_status_label(@order.status) %>
        </span>
      </div>

      <%= form_with model: [:admin, @order], method: :patch do |form| %>
        <div class="flex flex-col gap-3 sm:flex-row">
          <%= form.select :status,
                options_for_select(
                  [
                    ["Chờ xác nhận", "pending"],
                    ["Đã xác nhận", "confirmed"],
                    ["Đang giao", "shipping"],
                    ["Đã giao", "delivered"],
                    ["Đã hủy", "cancelled"]
                  ],
                  @order.status
                ),
                {},
                class: "flex-1 border border-[#D8D0B8] bg-white px-4 py-3 text-sm outline-none focus:border-[#123D2B]" %>

          <%= form.submit "CẬP NHẬT",
                class: "cursor-pointer bg-[#123D2B] px-7 py-3 text-xs font-semibold tracking-wide text-white hover:bg-[#1B5B3A]" %>
        </div>
      <% end %>
    </div>

    <%= link_to "← QUAY LẠI DANH SÁCH ĐƠN HÀNG",
          admin_orders_path,
          class: "text-xs font-semibold tracking-wide text-[#123D2B] hover:text-[#B99A55]" %>

  </div>
</div>
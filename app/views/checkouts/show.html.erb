<% content_for :title, "Thanh toán | BLACK GINSENG" %>

<section class="border-b border-[#D8D0B8] bg-[#F7F4EA] py-10">
  <div class="mx-auto max-w-7xl px-4 text-center">
    <p class="text-xs font-semibold tracking-[0.25em] text-[#A8873D]">
      BLACK GINSENG
    </p>
    <h1 class="mt-3 font-serif text-3xl font-bold text-[#123D2B]">
      THANH TOÁN
    </h1>
    <p class="mt-2 text-sm text-gray-500">
      Kiểm tra thông tin và xác nhận đơn hàng của bạn
    </p>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-12">
  <% if @addresses.any? %>
    <%= form_with url: checkout_path, method: :post, class: "grid grid-cols-1 items-start gap-8 lg:grid-cols-3" do |f| %>
      <div class="space-y-8 lg:col-span-2">

        <%# Địa chỉ giao hàng %>
        <div class="border border-[#D8D0B8] bg-white p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="font-serif text-lg font-bold text-[#123D2B]">
              01. ĐỊA CHỈ GIAO HÀNG
            </h2>

            <%= link_to "QUẢN LÝ ĐỊA CHỈ",
                  addresses_path,
                  class: "text-xs font-semibold text-[#1B5B3A] hover:text-[#A8873D]" %>
          </div>

          <div class="mt-5 space-y-3">
            <% @addresses.each do |address| %>
              <label class="flex cursor-pointer gap-3 border border-[#E2DDCE] p-4 transition hover:border-[#A8873D] has-[:checked]:border-[#123D2B] has-[:checked]:bg-[#F7F4EA]">
                <%= radio_button_tag :address_id,
                      address.id,
                      address.id.to_s == @selected_address_id.to_s,
                      required: true,
                      class: "mt-1 accent-[#123D2B]" %>

                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <strong class="text-sm text-[#123D2B]">
                      <%= address.recipient_name %>
                    </strong>

                    <span class="text-sm text-gray-500">
                      <%= address.phone %>
                    </span>

                    <% if address.is_default? %>
                      <span class="bg-[#EAF2EC] px-2 py-1 text-[10px] font-semibold text-[#1B5B3A]">
                        MẶC ĐỊNH
                      </span>
                    <% end %>
                  </span>

                  <span class="mt-2 block text-sm leading-relaxed text-gray-600">
                    <%= [
                      address.street_address,
                      address.ward,
                      address.province
                    ].reject(&:blank?).join(", ") %>
                  </span>

                  <span class="mt-1 block text-xs text-gray-400">
                    <%= address.label %>
                  </span>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <%# Phương thức thanh toán %>
        <div class="border border-[#D8D0B8] bg-white p-6">
          <h2 class="font-serif text-lg font-bold text-[#123D2B]">
            02. PHƯƠNG THỨC THANH TOÁN
          </h2>

          <div class="mt-5 space-y-3">
            <label class="flex cursor-pointer items-start gap-3 border border-[#E2DDCE] p-4 transition hover:border-[#A8873D] has-[:checked]:border-[#123D2B] has-[:checked]:bg-[#F7F4EA]">
              <%= radio_button_tag :payment_method,
                    "cod",
                    @selected_payment_method == "cod",
                    class: "mt-1 accent-[#123D2B]" %>

              <span class="flex-1">
                <strong class="block text-sm text-[#123D2B]">
                  Thanh toán khi nhận hàng (COD)
                </strong>
                <span class="mt-1 block text-xs leading-relaxed text-gray-500">
                  Bạn thanh toán bằng tiền mặt khi nhận được sản phẩm.
                </span>
              </span>
            </label>

            <label class="flex cursor-pointer items-start gap-3 border border-[#E2DDCE] p-4 transition hover:border-[#A8873D] has-[:checked]:border-[#123D2B] has-[:checked]:bg-[#F7F4EA]">
              <%= radio_button_tag :payment_method,
                    "vnpay",
                    @selected_payment_method == "vnpay",
                    class: "mt-1 accent-[#123D2B]" %>

              <span class="flex-1">
                <strong class="block text-sm text-[#123D2B]">
                  Thanh toán trực tuyến qua VNPAY
                </strong>
                <span class="mt-1 block text-xs leading-relaxed text-gray-500">
                  Thanh toán bằng ứng dụng ngân hàng hoặc các phương thức được VNPAY hỗ trợ.
                </span>
              </span>
            </label>
          </div>
        </div>

        <%# Ghi chú %>
        <div class="border border-[#D8D0B8] bg-white p-6">
          <h2 class="font-serif text-lg font-bold text-[#123D2B]">
            03. GHI CHÚ ĐƠN HÀNG
          </h2>

          <%= text_area_tag :note,
                nil,
                rows: 3,
                maxlength: 1000,
                placeholder: "Nhập ghi chú cho đơn hàng (nếu có)...",
                class: "mt-4 w-full border border-[#D8D0B8] bg-[#FFFEFA] px-4 py-3 text-sm outline-none focus:border-[#A8873D]" %>
        </div>
      </div>

      <%# Tổng đơn hàng %>
      <aside class="h-fit border border-[#D8D0B8] bg-[#F7F4EA] p-6">
        <h2 class="font-serif text-lg font-bold text-[#123D2B]">
          ĐƠN HÀNG CỦA BẠN
        </h2>

        <div class="mt-5 max-h-80 space-y-4 overflow-y-auto">
          <% @cart_items.each do |product, quantity| %>
            <div class="flex gap-3">
              <div class="flex h-16 w-16 shrink-0 items-center justify-center bg-white p-2">
                <% if product.image_url.present? %>
                  <%= image_tag product.image_url,
                        alt: product.name,
                        class: "h-full w-full object-contain" %>
                <% else %>
                  <span class="text-[10px] text-gray-400">Chưa có ảnh</span>
                <% end %>
              </div>

              <div class="min-w-0 flex-1">
                <p class="line-clamp-2 text-sm font-semibold text-[#123D2B]">
                  <%= product.name %>
                </p>
                <p class="mt-1 text-xs text-gray-500">
                  Số lượng: <%= quantity %>
                </p>
                <p class="mt-1 text-sm font-semibold text-[#1B5B3A]">
                  <%= format_vnd(product.price * quantity) %>
                </p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="mt-5 space-y-3 border-t border-[#D8D0B8] pt-5 text-sm">
          <div class="flex justify-between gap-3">
            <span class="text-gray-600">Tiền hàng</span>
            <strong class="text-[#123D2B]">
              <%= format_vnd(@subtotal) %>
            </strong>
          </div>

          <% if @promotion_code.present? && @discount_amount.to_d.positive? %>
            <div class="flex justify-between gap-3">
              <span class="text-gray-600">
                Mã khuyến mãi (<%= @promotion_code.code %>)
              </span>
              <strong class="text-red-600">
                -<%= format_vnd(@discount_amount) %>
              </strong>
            </div>
          <% end %>

          <div class="flex justify-between gap-3">
            <span class="text-gray-600">Phí vận chuyển</span>
            <strong class="text-[#123D2B]">
              <%= format_vnd(@shipping_fee) %>
            </strong>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-between gap-3 border-t border-[#D8D0B8] pt-5">
          <span class="font-semibold text-[#123D2B]">Tổng thanh toán</span>
          <strong class="text-xl text-[#1B5B3A]">
            <%= format_vnd(@total) %>
          </strong>
        </div>

        <%= f.submit "XÁC NHẬN ĐẶT HÀNG",
              class: "mt-6 w-full cursor-pointer bg-[#123D2B] px-4 py-4 text-sm font-bold tracking-wide text-white transition hover:bg-[#1B5B3A]" %>

        <%= link_to "QUAY LẠI GIỎ HÀNG",
              cart_path,
              class: "mt-4 block text-center text-xs font-semibold text-[#123D2B] hover:text-[#A8873D]" %>
      </aside>
    <% end %>
  <% else %>
    <div class="border border-[#D8D0B8] bg-white px-5 py-16 text-center">
      <p class="font-semibold text-[#123D2B]">
        Bạn chưa có địa chỉ giao hàng
      </p>
      <p class="mt-2 text-sm text-gray-500">
        Vui lòng thêm địa chỉ trước khi thanh toán.
      </p>

      <%= link_to "THÊM ĐỊA CHỈ GIAO HÀNG",
            new_address_path,
            class: "mt-6 inline-block bg-[#123D2B] px-7 py-3 text-sm font-semibold text-white hover:bg-[#1B5B3A]" %>
    </div>
  <% end %>
</section>

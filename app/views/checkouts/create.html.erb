<% content_for :title, "Đặt hàng thành công | BLACK GINSENG" %>

<div class="min-h-screen bg-[#F7F4EA] px-4 py-12">
  <div class="mx-auto max-w-4xl">

    <div class="mb-8 text-center">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-[#EAF2EC]">
        <svg class="h-9 w-9 text-[#1B5B3A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <p class="mb-2 text-sm font-semibold tracking-[0.2em] text-[#B99A55]">
        BLACK GINSENG
      </p>

      <h1 class="text-2xl font-semibold text-[#123D2B] md:text-3xl">
        ĐẶT HÀNG THÀNH CÔNG
      </h1>

      <p class="mt-3 text-sm leading-6 text-gray-600">
        Cảm ơn bạn đã tin tưởng và lựa chọn BLACK GINSENG.
        Chúng tôi sẽ sớm liên hệ để xác nhận đơn hàng.
      </p>
    </div>

    <div class="overflow-hidden border border-[#D8D0B8] bg-white shadow-sm">

      <div class="border-b border-[#D8D0B8] bg-[#EAF2EC] px-5 py-5 md:px-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs text-gray-500">MÃ ĐƠN HÀNG</p>
            <p class="mt-1 text-lg font-semibold tracking-wide text-[#123D2B]">
              <%= @order.order_number %>
            </p>
          </div>

          <span class="w-fit border border-[#B99A55] bg-white px-4 py-2 text-xs font-semibold text-[#8B6D2F]">
            CHỜ XÁC NHẬN
          </span>
        </div>
      </div>

      <div class="grid gap-8 p-5 md:grid-cols-2 md:p-8">

        <section>
          <h2 class="mb-4 text-sm font-semibold tracking-wide text-[#123D2B]">
            THÔNG TIN NHẬN HÀNG
          </h2>

          <div class="space-y-3 text-sm text-gray-600">
            <p>
              <span class="font-medium text-gray-800">Người nhận:</span>
              <%= @order.recipient_name %>
            </p>

            <p>
              <span class="font-medium text-gray-800">Số điện thoại:</span>
              <%= @order.phone %>
            </p>

            <p>
              <span class="font-medium text-gray-800">Địa chỉ:</span>
              <%= [@order.street_address, @order.ward, @order.province].compact_blank.join(", ") %>
            </p>

            <% if @order.note.present? %>
              <p>
                <span class="font-medium text-gray-800">Ghi chú:</span>
                <%= @order.note %>
              </p>
            <% end %>
          </div>
        </section>

        <section>
          <h2 class="mb-4 text-sm font-semibold tracking-wide text-[#123D2B]">
            PHƯƠNG THỨC THANH TOÁN
          </h2>

          <div class="border border-[#D8D0B8] p-4">
            <p class="font-medium text-gray-800">
              Thanh toán khi nhận hàng (COD)
            </p>
            <p class="mt-2 text-sm text-gray-500">
              Bạn thanh toán cho nhân viên giao hàng khi nhận được sản phẩm.
            </p>
            <p class="mt-3 text-xs font-medium text-[#8B6D2F]">
              Trạng thái thanh toán: Chưa thanh toán
            </p>
          </div>
        </section>

      </div>

      <div class="border-t border-[#D8D0B8] px-5 py-6 md:px-8">
        <h2 class="mb-5 text-sm font-semibold tracking-wide text-[#123D2B]">
          CHI TIẾT ĐƠN HÀNG
        </h2>

        <div class="space-y-5">
          <% @order.order_items.each do |item| %>
            <div class="flex gap-4">
              <% if item.product_image.present? %>
                <%= image_tag item.product_image,
                    class: "h-20 w-20 shrink-0 border border-[#D8D0B8] object-cover",
                    alt: item.product_name %>
              <% else %>
                <div class="flex h-20 w-20 shrink-0 items-center justify-center border border-[#D8D0B8] bg-[#F7F4EA] text-xs text-gray-400">
                  BLACK GINSENG
                </div>
              <% end %>

              <div class="min-w-0 flex-1">
                <p class="font-medium text-[#123D2B]">
                  <%= item.product_name %>
                </p>

                <p class="mt-1 text-sm text-gray-500">
                  Số lượng: <%= item.quantity %>
                </p>

                <p class="mt-2 text-sm font-semibold text-[#A83232]">
                  <%= format_vnd(item.total_price) %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="border-t border-[#D8D0B8] bg-[#FCFBF7] px-5 py-6 md:px-8">
        <div class="ml-auto max-w-sm space-y-3 text-sm">
          <div class="flex justify-between text-gray-600">
            <span>Tiền hàng</span>
            <span>
              <%= format_vnd(@order.subtotal) %>
            </span>
          </div>

          <% if @order.promotion_code.present? && @order.discount_amount.to_d.positive? %>
            <div class="flex justify-between gap-3 text-gray-600">
              <span>
                Mã khuyến mãi (<%= @order.promotion_code %>)
              </span>
              <span class="font-semibold text-red-600">
                -<%= format_vnd(@order.discount_amount) %>
              </span>
            </div>
          <% end %>

          <div class="flex justify-between text-gray-600">
            <span>Phí vận chuyển</span>
            <span>
              <%= format_vnd(@order.shipping_fee) %>
            </span>
          </div>

          <div class="flex justify-between border-t border-[#D8D0B8] pt-4 text-base font-semibold text-[#123D2B]">
            <span>Tổng thanh toán</span>
            <span class="text-[#A83232]">
              <%= format_vnd(@order.total) %>
            </span>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <%= link_to "XEM CHI TIẾT ĐƠN HÀNG",
          order_path(@order),
          class: "bg-[#123D2B] px-7 py-3 text-center text-xs font-semibold tracking-wider text-white transition hover:bg-[#1B5B3A]" %>

      <%= link_to "TIẾP TỤC MUA SẮM",
          products_path,
          class: "border border-[#123D2B] px-7 py-3 text-center text-xs font-semibold tracking-wider text-[#123D2B] transition hover:bg-[#123D2B] hover:text-white" %>

      <%= link_to "VỀ TRANG CHỦ",
          root_path,
          class: "bg-[#123D2B] px-7 py-3 text-center text-xs font-semibold tracking-wider text-white transition hover:bg-[#1B5B3A]" %>
    </div>

  </div>
</div>

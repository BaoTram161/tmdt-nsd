<% content_for :title, "Đăng ký | BLACK GINSENG" %>

<section class="min-h-[650px] bg-[#F7F4EA] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md bg-white border border-[#D8D0B8] p-7 md:p-10 shadow-sm">

    <!-- Tiêu đề -->
    <div class="text-center mb-8">
      <p class="text-xs tracking-[0.25em] font-semibold text-[#A8873D]">
        BLACK GINSENG
      </p>

      <h1 class="mt-3 text-2xl font-serif font-bold text-[#123D2B]">
        TẠO TÀI KHOẢN
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Trở thành khách hàng của BLACK GINSENG
      </p>
    </div>

    <!-- Thông báo lỗi -->
    <% if @user.errors.any? %>
      <div class="mb-5 p-4 bg-red-50 border border-red-200 text-red-700 text-sm">
        <p class="font-semibold mb-2">Vui lòng kiểm tra lại thông tin:</p>

        <ul class="list-disc pl-5 space-y-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Form đăng ký -->
    <%= form_with model: @user, url: registration_path do |form| %>

      <!-- Email -->
      <div class="mb-5">
        <%= form.label :email_address, "Email",
              class: "block mb-2 text-sm font-medium text-[#123D2B]" %>

        <%= form.email_field :email_address,
              required: true,
              autofocus: true,
              autocomplete: "email",
              placeholder: "Nhập địa chỉ email",
              class: "w-full h-12 px-4 border border-[#D8D0B8] text-sm focus:outline-none focus:border-[#A8873D]" %>
      </div>

      <!-- Mật khẩu -->
      <div class="mb-5">
        <%= form.label :password, "Mật khẩu",
              class: "block mb-2 text-sm font-medium text-[#123D2B]" %>

        <div data-controller="password-visibility"
             style="position: relative; width: 100%;">

          <%= form.password_field :password,
                required: true,
                minlength: 8,
                maxlength: 72,
                autocomplete: "new-password",
                placeholder: "Tối thiểu 8 ký tự",
                data: { password_visibility_target: "input" },
                class: "w-full h-12 pl-4 pr-12 border border-[#D8D0B8] text-sm focus:outline-none focus:border-[#A8873D]" %>

          <!-- Nút hiện / ẩn mật khẩu -->
          <button type="button"
                  data-action="password-visibility#toggle"
                  aria-label="Hiện hoặc ẩn mật khẩu"
                  style="position: absolute; top: 0; right: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; color: #6B7280; cursor: pointer;">

            <!-- Icon con mắt -->
            <svg data-password-visibility-target="eye"
                 class="h-5 w-5"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>

            <!-- Icon con mắt bị gạch -->
            <svg data-password-visibility-target="eyeOff"
                 class="hidden h-5 w-5"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
              <path d="m3 3 18 18"></path>
              <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
              <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.5 15.5 0 0 1-3.1 3.8"></path>
              <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.2 0 2.3-.2 3.3-.6"></path>
            </svg>

          </button>
        </div>
      </div>

      <!-- Xác nhận mật khẩu -->
      <div class="mb-6">
        <%= form.label :password_confirmation, "Xác nhận mật khẩu",
              class: "block mb-2 text-sm font-medium text-[#123D2B]" %>

        <div data-controller="password-visibility"
             style="position: relative; width: 100%;">

          <%= form.password_field :password_confirmation,
                required: true,
                minlength: 8,
                maxlength: 72,
                autocomplete: "new-password",
                placeholder: "Nhập lại mật khẩu",
                data: { password_visibility_target: "input" },
                class: "w-full h-12 pl-4 pr-12 border border-[#D8D0B8] text-sm focus:outline-none focus:border-[#A8873D]" %>

          <!-- Nút hiện / ẩn mật khẩu -->
          <button type="button"
                  data-action="password-visibility#toggle"
                  aria-label="Hiện hoặc ẩn mật khẩu"
                  style="position: absolute; top: 0; right: 0; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; color: #6B7280; cursor: pointer;">

            <!-- Icon con mắt -->
            <svg data-password-visibility-target="eye"
                 class="h-5 w-5"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>

            <!-- Icon con mắt bị gạch -->
            <svg data-password-visibility-target="eyeOff"
                 class="hidden h-5 w-5"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.7"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
              <path d="m3 3 18 18"></path>
              <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
              <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.5 15.5 0 0 1-3.1 3.8"></path>
              <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.2 0 2.3-.2 3.3-.6"></path>
            </svg>

          </button>
        </div>
      </div>

      <!-- Nút đăng ký -->
      <%= form.submit "ĐĂNG KÝ",
            class: "w-full h-12 bg-[#123D2B] text-white text-sm font-semibold tracking-wide hover:bg-[#1B5B3A] transition cursor-pointer" %>

    <% end %>

    <!-- Liên kết đăng nhập -->
    <div class="mt-7 pt-6 border-t border-[#E5DFCF] text-center">
      <p class="text-sm text-gray-500">
        Bạn đã có tài khoản?
        <%= link_to "Đăng nhập",
              new_session_path,
              class: "font-semibold text-[#A8873D] hover:underline" %>
      </p>
    </div>

  </div>
</section>
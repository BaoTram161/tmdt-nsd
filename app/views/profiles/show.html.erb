<% content_for :title, "Tài khoản của tôi | BLACK GINSENG" %>

<section class="border-b border-[#D8D0B8] bg-[#F7F4EA] py-10">
  <div class="mx-auto max-w-7xl px-4 text-center">
    <p class="text-xs font-semibold tracking-[0.25em] text-[#A8873D]">BLACK GINSENG</p>
    <h1 class="mt-3 font-serif text-3xl font-bold text-[#123D2B]">TÀI KHOẢN CỦA TÔI</h1>
    <p class="mt-2 text-sm text-gray-500">Quản lý thông tin cá nhân và địa chỉ giao hàng</p>
  </div>
</section>

<section class="mx-auto w-full max-w-7xl px-4 py-12">
  <div class="grid grid-cols-[280px_minmax(0,1fr)] gap-8">

    <aside class="h-fit border border-[#D8D0B8] bg-white p-5">
      <h2 class="font-serif text-lg font-bold text-[#123D2B]">QUẢN LÝ TÀI KHOẢN</h2>

      <div class="mt-5 space-y-1">
        <%= link_to profile_path,
              class: "block bg-[#F7F4EA] px-4 py-3 text-sm font-semibold text-[#123D2B]" do %>
          Thông tin cá nhân
        <% end %>

        <%= link_to addresses_path,
              class: "block px-4 py-3 text-sm text-gray-600 transition hover:bg-[#F7F4EA] hover:text-[#123D2B]" do %>
          Địa chỉ giao hàng
        <% end %>
      </div>
    </aside>

    <div class="border border-[#D8D0B8] bg-white p-6 md:p-8">
      <h2 class="font-serif text-xl font-bold text-[#123D2B]">THÔNG TIN CÁ NHÂN</h2>
      <p class="mt-2 text-sm text-gray-500">Cập nhật thông tin liên hệ của bạn.</p>

      <% if @user.errors.any? %>
        <div class="mt-5 border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <p class="font-semibold">Vui lòng kiểm tra lại thông tin:</p>
          <ul class="mt-2 list-inside list-disc">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: profile_path, method: :patch,
            class: "mt-7 space-y-5" do |f| %>

        <div>
          <%= f.label :full_name, "Họ và tên",
                class: "mb-2 block text-sm font-semibold text-[#244331]" %>
          <%= f.text_field :full_name,
                autocomplete: "name",
                placeholder: "Nhập họ và tên",
                class: "w-full border border-[#D8D0B8] bg-[#FFFEFA] px-4 py-3 text-sm text-[#24392D] outline-none focus:border-[#A8873D] focus:ring-1 focus:ring-[#A8873D]" %>
        </div>

        <div>
          <%= f.label :phone, "Số điện thoại",
                class: "mb-2 block text-sm font-semibold text-[#244331]" %>
          <%= f.telephone_field :phone,
                autocomplete: "tel",
                placeholder: "Nhập số điện thoại",
                class: "w-full border border-[#D8D0B8] bg-[#FFFEFA] px-4 py-3 text-sm text-[#24392D] outline-none focus:border-[#A8873D] focus:ring-1 focus:ring-[#A8873D]" %>
        </div>

        <div>
          <%= f.label :email_address, "Email",
                class: "mb-2 block text-sm font-semibold text-[#244331]" %>
          <%= f.email_field :email_address,
                autocomplete: "email",
                required: true,
                class: "w-full border border-[#D8D0B8] bg-[#FFFEFA] px-4 py-3 text-sm text-[#24392D] outline-none focus:border-[#A8873D] focus:ring-1 focus:ring-[#A8873D]" %>
        </div>

        <div class="border-t border-[#E8E2D5] pt-5">
          <%= f.submit "LƯU THAY ĐỔI",
                class: "w-full cursor-pointer bg-[#123D2B] px-6 py-3 text-sm font-semibold tracking-wide text-white transition hover:bg-[#1B5B3A] sm:w-auto" %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<header class="relative z-30 bg-[#E8DFC9] border-b border-[#D2C5A8]">
  <div class="max-w-7xl mx-auto px-4 md:px-5">

    <div class="grid grid-cols-1 items-center gap-3 py-3 lg:grid-cols-[450px_minmax(260px,1fr)_190px] lg:gap-7">

      <!-- LOGO VÀ THƯƠNG HIỆU -->
      <%= link_to root_path,
            class: "flex min-w-0 items-center justify-center gap-3 lg:justify-start" do %>

        <%= image_tag "black-ginseng-emblem.png",
              alt: "Biểu tượng nhân sâm đen",
              class: "h-[75px] w-[78px] md:h-[94px] md:w-[98px] shrink-0 object-contain" %>

        <div class="flex min-w-0 flex-col items-center">
          <span class="whitespace-nowrap font-serif text-xl md:text-[29px] font-bold tracking-[0.065em] leading-tight text-[#123D2B]">
            BLACK GINSENG
          </span>

          <span class="mt-2 md:mt-3 whitespace-nowrap text-[9px] md:text-[10px] font-medium tracking-[0.14em] text-[#987638]">
            TỪ MAGASAM WISCONSIN - HOA KỲ
          </span>
        </div>
      <% end %>

      <!-- TÌM KIẾM -->
      <%= form_with url: products_path, method: :get,
            class: "flex w-full" do |f| %>

        <%= f.search_field :q,
              placeholder: "Tìm kiếm sản phẩm...",
              value: params[:q],
              class: "h-[44px] w-full min-w-0 rounded-l-md border border-[#D6CCB6] border-r-0 bg-[#FFFEFA] px-4 text-sm text-[#24392D] placeholder:text-[#A69D8D] focus:border-[#A8873D] focus:outline-none focus:ring-1 focus:ring-[#A8873D]" %>

        <%= button_tag type: "submit",
              aria: { label: "Tìm kiếm" },
              class: "flex h-[44px] w-[52px] shrink-0 items-center justify-center rounded-r-md bg-[#123D2B] text-white transition hover:bg-[#1B5B3A]" do %>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8"></circle>
            <path d="m16 16 4.5 4.5"></path>
          </svg>
        <% end %>
      <% end %>

      <!-- YÊU THÍCH VÀ GIỎ HÀNG -->
      <div class="flex items-center justify-center gap-6 lg:justify-end">

        <%= link_to wishlist_path,
              class: "relative flex items-center gap-2 whitespace-nowrap text-[#244331] transition hover:text-[#A8873D]" do %>
          <svg class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M20.8 8.8c0 5.1-8.8 11-8.8 11s-8.8-5.9-8.8-11A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z"></path>
          </svg>
          <span class="text-xs font-medium">Yêu thích</span>

          <% wishlist_count = (session[:wishlist] || []).size %>
          <% if wishlist_count > 0 %>
            <span class="absolute -top-2 -right-3 min-w-5 h-5 rounded-full bg-[#A8873D] px-1 text-center text-[10px] leading-5 text-white">
              <%= wishlist_count %>
            </span>
          <% end %>
        <% end %>

        <%= link_to cart_path,
              class: "relative flex items-center gap-2 whitespace-nowrap text-[#244331] transition hover:text-[#A8873D]" do %>
          <svg class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M3 3h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.5L22 7H6"></path>
            <circle cx="10" cy="20" r="1.3"></circle>
            <circle cx="18" cy="20" r="1.3"></circle>
          </svg>
          <span class="text-xs font-medium">Giỏ hàng</span>

          <% cart_count = (session[:cart] || {}).values.sum { |quantity| quantity.to_i } %>
          <% if cart_count > 0 %>
            <span class="absolute -top-2 -right-3 min-w-5 h-5 rounded-full bg-[#A8873D] px-1 text-center text-[10px] leading-5 text-white">
              <%= cart_count %>
            </span>
          <% end %>
        <% end %>

      </div>
    </div>
  </div>
</header>

<!-- THANH ĐIỀU HƯỚNG -->
<nav class="sticky top-0 z-40 bg-[#123D2B] text-white shadow-sm">
  <div class="max-w-7xl mx-auto flex items-center gap-1 overflow-x-auto px-3 md:px-5 text-xs md:text-sm font-semibold">

    <%= link_to "TRANG CHỦ", root_path,
          class: "whitespace-nowrap border-b-[3px] px-4 md:px-5 py-4 transition #{current_page?(root_path) ? 'border-[#D4AF62] text-[#E9CF8A]' : 'border-transparent hover:border-[#D4AF62] hover:text-[#E9CF8A]'}" %>

    <!-- DANH MỤC SẢN PHẨM -->
    <div class="relative group">
      <%= link_to products_path,
            class: "flex items-center gap-2 whitespace-nowrap border-b-[3px] border-transparent px-4 md:px-5 py-4 transition hover:border-[#D4AF62] hover:text-[#E9CF8A]" do %>
        SẢN PHẨM
        <span class="text-xs">▾</span>
      <% end %>

      <div class="absolute left-0 top-full hidden min-w-56 rounded-b-md border border-[#E2D8BB] bg-white py-2 shadow-xl group-hover:block group-focus-within:block">

        <% nav_categories.each do |category| %>
          <% category.children.each do |child| %>
            <%= link_to child.name, products_path(category_id: child.id),
                  class: "block px-5 py-3 text-sm font-medium text-[#244331] transition hover:bg-[#F4F2E9]" %>
          <% end %>
        <% end %>

        <%= link_to "Tất cả sản phẩm", products_path,
              class: "block border-t border-[#E2D8BB] px-5 py-3 text-sm font-semibold text-[#A8873D] hover:bg-[#F4F2E9]" %>
      </div>
    </div>

    <%= link_to "GIỚI THIỆU", root_path(anchor: "gioi-thieu"),
          class: "whitespace-nowrap border-b-[3px] border-transparent px-4 md:px-5 py-4 transition hover:border-[#D4AF62] hover:text-[#E9CF8A]" %>

    <%= link_to "LIÊN HỆ", root_path(anchor: "lien-he"),
          class: "whitespace-nowrap border-b-[3px] border-transparent px-4 md:px-5 py-4 transition hover:border-[#D4AF62] hover:text-[#E9CF8A]" %>

  </div>
</nav>
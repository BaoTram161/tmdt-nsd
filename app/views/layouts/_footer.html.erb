<footer id="lien-he" class="mt-auto bg-[#0B291D] text-gray-200">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div style="display:flex !important; flex-direction:row !important; flex-wrap:nowrap !important; align-items:flex-start; gap:24px; width:100%;">

      <!-- THƯƠNG HIỆU -->
      <div style="flex:0 0 38%; min-width:0;">
        <h2 class="text-2xl font-serif font-bold tracking-wider text-[#E9CF8A]">
          BLACK GINSENG
        </h2>
        <p class="text-xs tracking-[0.2em] text-[#B99A55] mt-2">
          TỪ MAGASAM WISCONSIN - HOA KỲ
        </p>
        <p class="mt-5 text-sm leading-7 text-gray-300">
          Không gian mua sắm chuyên biệt dành cho các sản phẩm nhân sâm đen.
        </p>
      </div>

      <!-- ĐIỀU HƯỚNG -->
      <div style="flex:0 0 25%; min-width:0; display:flex; justify-content:center;">
        <div>
          <h3 class="font-semibold tracking-wider text-[#E9CF8A]">
            KHÁM PHÁ
          </h3>
          <ul class="mt-5 space-y-3 text-sm text-gray-300">
            <% [["Trang chủ", root_path], ["Sản phẩm", "#san-pham"], ["Giới thiệu", "#gioi-thieu"], ["Liên hệ", "#lien-he"]].each do |label, path| %>
              <li>
                <%= link_to label, path, class: "hover:text-[#E9CF8A] transition" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- THÔNG TIN CỬA HÀNG -->
      <div style="flex:1 1 0; min-width:0;">
        <h3 class="font-semibold tracking-wider text-[#E9CF8A]">
          THÔNG TIN CỬA HÀNG
        </h3>
        <ul class="mt-5 space-y-3 text-sm text-gray-300">
          <li>Thương hiệu: BLACK GINSENG</li>
          <li>Danh mục: Nhân sâm đen</li>
          <li>
            <a href="tel:+84902663336"
               class="inline-flex items-center gap-2 hover:text-[#E9CF8A] transition">
              <svg xmlns="http://www.w3.org/2000/svg"
                   width="17" height="17" viewBox="0 0 24 24"
                   fill="none" stroke="#B99A55" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3l1 5.5-2 2a16 16 0 0 0 6 6l2-2 5.5 1.4z"/>
              </svg>
              <span>(+84) 902 663 336</span>
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div class="border-t border-white/15 px-4 py-5 text-center text-xs text-gray-400">
    © <%= Date.current.year %> BLACK GINSENG. All rights reserved.
  </div>
</footer>
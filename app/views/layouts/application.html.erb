<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for(:title) || "BLACK GINSENG | Nhân sâm đen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="BLACK GINSENG - Nhân sâm đen từ Wisconsin, Hoa Kỳ.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-white text-gray-800">
    <%= render "layouts/header" %>

    <% flash.each do |type, message| %>
      <div class="max-w-7xl mx-auto w-full px-4 mt-4">
        <p class="px-4 py-3 rounded-md text-sm <%= type == 'alert' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
          <%= message %>
        </p>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>